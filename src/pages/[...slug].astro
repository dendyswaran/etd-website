---
import { pages } from '../data/pages';
import SeoHead from '../components/SeoHead.astro';
import { Image } from 'astro:assets';
import { articleIllustrations } from '../data/article-illustrations';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.scss';
export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}
const { page } = Astro.props;
const illustration = articleIllustrations[page.slug];
const canonical = new URL(`/${page.slug}/`, Astro.site).href;
const title = `${page.title} | East Town Digital`;
const related = page.related.map((slug) =>
  pages.find((item) => item.slug === slug)!,
);
const home = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: page.description,
      inLanguage: 'en',
      isPartOf: { '@id': `${home}#website` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: home },
        { '@type': 'ListItem', position: 2, name: page.title, item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en" class="cds--white">
  <head>
    <SeoHead
      title={title}
      description={page.description}
      canonical={canonical}
      structuredData={structuredData}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header page-grid">
      <a class="brand" href="/" aria-label="East Town Digital home">
        East Town<span class="brand-second">Digital</span>
      </a>
      <nav class="header-note" aria-label="Main navigation">
        <a href="/#layanan">SERVICES</a>
        <a href="/#pengalaman">EXPERIENCE</a>
      </nav>
      <a
        class="cds--btn cds--btn--tertiary header-contact"
        href="https://wa.me/62817131366"
        data-contact-location="header"
        target="_blank"
        rel="noopener noreferrer"
      >
        Contact us ↗
      </a>
    </header>
    <main id="main" class="detail-page">
      <div class="page-grid detail-intro">
        <nav class="detail-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true"> / </span>
          <span>{page.kind}</span>
        </nav>
        <p class="eyebrow detail-label">
          EAST TOWN DIGITAL / {page.kind.toUpperCase()}
        </p>
        <h1 class="detail-title">{page.title}</h1>
        <p class="detail-lead">{page.lead}</p>
        {illustration && (
          <figure class="article-illustration">
            <Image
              src={illustration.image}
              alt={illustration.alt}
              widths={[480, 768, 1152, 1536]}
              sizes="(max-width: 671px) calc(100vw - 48px), (max-width: 1055px) calc(100vw - 64px), min(75vw, 1120px)"
              format="webp"
              quality={80}
              loading="eager"
              decoding="async"
            />
            <figcaption>{illustration.caption}</figcaption>
          </figure>
        )}
      </div>
      <div class="page-grid detail-body">
        <aside class="detail-aside" aria-label="On this page">
          <p class="eyebrow">ON THIS PAGE</p>
          <nav>
            {page.sections.map((section, index) => (
              <a href={`#bagian-${index + 1}`}>{section.heading}</a>
            ))}
          </nav>
        </aside>
        <div class="detail-copy">
          {page.sections.map((section, index) => (
            <section id={`bagian-${index + 1}`}>
              <h2>{section.heading}</h2>
              <p>{section.text}</p>
            </section>
          ))}
        </div>
      </div>
      <section class="section-wrap" aria-labelledby="related-heading">
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">READ MORE</p>
            <h2 id="related-heading">Related reading.</h2>
          </div>
          <div class="work-list">
            {related.map((item) => (
              <article>
                <p class="eyebrow">{item.kind}</p>
                <h3>
                  <a class="resource-link" href={`/${item.slug}/`}>
                    {item.title} ↗
                  </a>
                </h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="section-wrap" aria-labelledby="discussion-heading">
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">DISCUSS A PROJECT</p>
            <h2 id="discussion-heading">Tell us about your business needs.</h2>
          </div>
          <div class="service-list">
            <p>
              Send a summary of your workflow, challenges, and target timeline
              through WhatsApp. Examples of spreadsheets or applications you use
              help us understand the project.
            </p>
            <a
              class="cds--btn cds--btn--primary contact-button detail-contact"
              href="https://wa.me/62817131366"
              data-contact-location="contact"
              target="_blank"
              rel="noopener noreferrer"
            >
              Discuss your project ↗
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer page-grid">
      <a class="footer-brand" href="/">
        EAST TOWN DIGITAL ↗
      </a>
      <span>© {new Date().getFullYear()} East Town Digital</span>
    </footer>
  </body>
</html>
