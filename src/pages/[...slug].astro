---
import { pages } from '../data/pages';
import SeoHead from '../components/SeoHead.astro';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.scss';
export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}
const { page } = Astro.props;
const canonical = new URL(`/${page.slug}/`, Astro.site).href;
const title = `${page.title} | East Town Digital`;
const related = page.related.map((slug) =>
  pages.find((item) => item.slug === slug)!,
);
const home = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: page.description,
      inLanguage: 'id-ID',
      isPartOf: { '@id': `${home}#website` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: home },
        { '@type': 'ListItem', position: 2, name: page.title, item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="id" class="cds--white">
  <head>
    <SeoHead
      title={title}
      description={page.description}
      canonical={canonical}
      structuredData={structuredData}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Langsung ke konten
    </a>
    <header class="site-header page-grid">
      <a class="brand" href="/" aria-label="Beranda East Town Digital">
        East Town<span class="brand-second">Digital</span>
      </a>
      <nav class="header-note" aria-label="Navigasi utama">
        <a href="/#layanan">LAYANAN</a>
        <a href="/#pengalaman">PENGALAMAN</a>
      </nav>
      <a
        class="cds--btn cds--btn--tertiary header-contact"
        href="https://wa.me/62817131366"
        data-contact-location="header"
        target="_blank"
        rel="noopener noreferrer"
      >
        Hubungi Kami ↗
      </a>
    </header>
    <main id="main" class="detail-page">
      <div class="page-grid detail-intro">
        <nav class="detail-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span aria-hidden="true"> / </span>
          <span>{page.kind}</span>
        </nav>
        <p class="eyebrow detail-label">
          EAST TOWN DIGITAL / {page.kind.toUpperCase()}
        </p>
        <h1 class="detail-title">{page.title}</h1>
        <p class="detail-lead">{page.lead}</p>
      </div>
      <div class="page-grid detail-body">
        <aside class="detail-aside" aria-label="Dalam halaman ini">
          <p class="eyebrow">DALAM HALAMAN INI</p>
          <nav>
            {page.sections.map((section, index) => (
              <a href={`#bagian-${index + 1}`}>{section.heading}</a>
            ))}
          </nav>
        </aside>
        <div class="detail-copy">
          {page.sections.map((section, index) => (
            <section id={`bagian-${index + 1}`}>
              <h2>{section.heading}</h2>
              <p>{section.text}</p>
            </section>
          ))}
        </div>
      </div>
      <section class="section-wrap" aria-labelledby="related-heading">
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">BACA JUGA</p>
            <h2 id="related-heading">Konteks untuk langkah berikutnya.</h2>
          </div>
          <div class="work-list">
            {related.map((item) => (
              <article>
                <p class="eyebrow">{item.kind}</p>
                <h3>
                  <a class="resource-link" href={`/${item.slug}/`}>
                    {item.title} ↗
                  </a>
                </h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="section-wrap" aria-labelledby="discussion-heading">
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">MULAI DARI PERCAKAPAN</p>
            <h2 id="discussion-heading">Ceritakan kebutuhan bisnis Anda.</h2>
          </div>
          <div class="service-list">
            <p>
              Diskusikan alur kerja, kendala, dan tujuan proyek Anda dengan East
              Town Digital. Berbekal pengalaman 15+ tahun di IT, kami memulai
              dari kebutuhan yang ingin Anda selesaikan.
            </p>
            <a
              class="cds--btn cds--btn--primary contact-button detail-contact"
              href="https://wa.me/62817131366"
              data-contact-location="contact"
              target="_blank"
              rel="noopener noreferrer"
            >
              Diskusi Proyek ↗
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer page-grid">
      <a class="footer-brand" href="/">
        EAST TOWN DIGITAL ↗
      </a>
      <span>© {new Date().getFullYear()} East Town Digital</span>
    </footer>
    <script>
      import { gsap } from 'gsap';
      gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        gsap.from('.detail-intro > :not(nav)', {
          y: 16,
          duration: 0.7,
          stagger: 0.08,
          ease: 'power2.out',
          clearProps: 'all',
        });
      });
    </script>
  </body>
</html>
