---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.scss';
import SeoHead from '../components/SeoHead.astro';
import { pages } from '../data/pages';

const whatsapp = 'https://wa.me/62817131366';
const resourceGroups = ['Services', 'Case studies', 'Guides'].map((kind) => ({
  kind,
  pages: pages.filter((page) => page.kind === kind),
}));
const year = new Date().getFullYear();
const canonical = new URL('/', Astro.site).href;
const title = 'Software House & AI Solutions in Indonesia | East Town Digital';
const description =
  'Software house and AI solutions for businesses in Indonesia. Backed by 15+ years in IT, we build AI agents, speech-to-text workflows, and business applications.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonical}#organization`,
      name: 'East Town Digital',
      url: canonical,
      description,
      logo: new URL('/logo.png', Astro.site).href,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+62817131366',
        contactType: 'sales',
        availableLanguage: ['Indonesian'],
        areaServed: { '@type': 'Country', name: 'Indonesia' },
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: 'East Town Digital',
      inLanguage: 'en',
      publisher: { '@id': `${canonical}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${canonical}#website` },
      about: { '@id': `${canonical}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="cds--white">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      structuredData={structuredData}
    />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header page-grid">
      <a class="brand" href="#top" aria-label="East Town Digital home">
        <svg
          class="brand-mark"
          viewBox="0 0 40 40"
          fill="none"
          aria-hidden="true"
        >
          <path d="M4 6h29v6H10v5h19v6H10v5h23v6H4V6Z" fill="currentColor" />
          <path d="m27 16 9 4-9 4v-8Z" fill="currentColor" />
        </svg>
        <span>
          East Town<span class="brand-second">Digital</span>
        </span>
      </a>
      <nav class="header-note" aria-label="Main navigation">
        <a href="#ai">AI &amp; AUTOMATION</a>
        <a href="#layanan">SERVICES</a>
        <a href="#pengalaman">EXPERIENCE</a>
        <a href="#contact">CONTACT</a>
      </nav>
      <a
        class="cds--btn cds--btn--tertiary header-contact"
        href={whatsapp}
        data-contact-location="header"
        target="_blank"
        rel="noopener noreferrer"
      >
        Contact us <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-field" aria-hidden="true">
          <canvas id="east-field"></canvas>
        </div>
        <div class="hero-inner page-grid">
          <p class="eyebrow hero-eyebrow">
            SOFTWARE &amp; AI FOR BUSINESSES IN INDONESIA
          </p>
          <h1 id="hero-heading" class="hero-title">
            <span>Software house and AI for</span>
            <span>your business operations.</span>
          </h1>
          <div class="hero-proof">
            <p class="eyebrow">DEVELOPMENT EXPERIENCE</p>
            <a class="resource-link" href="/studi-kasus/ai-quality-assurance/">
              Service recordings → transcripts → QA evaluation
            </a>
            <p>Assessment rubrics, coaching notes, and human review.</p>
          </div>
          <div class="hero-action">
            <p>
              We build websites, business applications, and system integrations.
              From inventory records to AI-assisted conversation evaluation.
            </p>
            <a
              class="cds--btn cds--btn--primary contact-button"
              href={whatsapp}
              data-contact-location="hero"
              target="_blank"
              rel="noopener noreferrer"
            >
              Discuss your project{' '}
              <span class="button-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
            <span class="contact-caption">DIRECTLY VIA WHATSAPP</span>
          </div>
          <div class="hero-baseline">
            <a class="scroll-link" href="#hello">
              <span aria-hidden="true">↓</span> MEET THE TEAM
            </a>
            <button
              type="button"
              class="cds--btn cds--btn--ghost motion-toggle"
              aria-controls="east-field"
              hidden
            >
              Pause animation
            </button>
          </div>
        </div>
      </section>
      <section
        class="introduction section-wrap"
        id="hello"
        aria-labelledby="intro-heading"
      >
        <div class="intro-card page-grid">
          <p class="eyebrow intro-label">01 / ABOUT EAST TOWN DIGITAL</p>
          <div class="intro-copy">
            <h2 id="intro-heading">
              A new name.
              <br />
              Years of experience.
            </h2>
            <p>
              East Town Digital is a software house founded by two partners with
              more than 15 years of IT experience. We help businesses in
              Indonesia develop websites, business applications, mobile
              applications, system integrations, and AI solutions. Our team uses
              AI in development and builds applications of it for business
              operations.
            </p>
            <p>
              Every business has its own way of working. We start with your
              processes, the challenges you face, and the goals you want to
              achieve, so the software has a clear purpose.
            </p>
          </div>
          <aside class="experience">
            <p class="eyebrow">TWO PARTNERS, 15+ YEARS IN IT</p>
            <p>
              Our development experience includes salon POS and reservations,
              service queues, and financial and project monitoring.
            </p>
            <a class="resource-link" href="#pengalaman">
              Explore our development experience ↓
            </a>
          </aside>
        </div>
      </section>
      <section class="section-wrap" id="ai" aria-labelledby="ai-heading">
        <div class="editorial-card page-grid ai-card">
          <div class="section-heading">
            <p class="eyebrow">02 / AI IN PRACTICE</p>
            <h2 id="ai-heading">
              Agents, transcription,
              <br />
              and service evaluation.
            </h2>
            <p>
              We use AI in software development and help you apply it to
              business tasks. From agents to conversation analysis, each
              workflow starts with clear goals and evaluation criteria.
            </p>
            <a class="resource-link" href="/solusi-ai/">
              Explore AI solutions <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="service-list">
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                01
              </span>
              <h3>AI agents &amp; agent harnesses</h3>
              <p>
                Our team works with a range of agent harnesses. We design
                context, tool use, and agent integrations with engineer review
                and action limits suited to the task.
              </p>
            </article>
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                02
              </span>
              <h3>AI training &amp; adaptation</h3>
              <p>
                Data preparation, reference knowledge, and evaluation help adapt
                AI to your business context. Adaptation methods and training
                needs follow data readiness, goals, and evaluation results.
              </p>
            </article>
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                03
              </span>
              <h3>Speech-to-text &amp; quality assurance</h3>
              <p>
                Turn recordings into transcripts, rubric-based evaluations, and
                coaching material. Our experience includes reviewer corrections
                and report exports within this workflow.
              </p>
              <a
                class="resource-link"
                href="/studi-kasus/ai-quality-assurance/"
              >
                Explore our AI QA experience <span aria-hidden="true">↗</span>
              </a>
            </article>
          </div>
        </div>
      </section>
      <section
        class="section-wrap"
        id="layanan"
        aria-labelledby="services-heading"
      >
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">03 / OUR SERVICES</p>
            <h2 id="services-heading">
              Software that fits
              <br />
              the way you work.
            </h2>
            <p>
              From your online presence to operational processes, we help you
              choose and build solutions around your needs.
            </p>
          </div>
          <div class="service-list">
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                01
              </span>
              <h3>Website development</h3>
              <p>
                Company websites, product pages, and CMS websites your team can
                manage. Designed to explain your business clearly and help
                potential customers get in touch.
              </p>
            </article>
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                02
              </span>
              <h3>Business applications &amp; custom software</h3>
              <p>
                Applications for transactions, inventory, reservations, queues,
                and financial and project monitoring. Workflows are tailored to
                your business operations.
              </p>
            </article>
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                03
              </span>
              <h3>Mobile application development</h3>
              <p>
                Applications for customers or field teams, including mobile web
                and PWAs. Platform and feature choices follow your devices,
                users, and the work involved.
              </p>
            </article>
            <article class="service-row">
              <span class="eyebrow" aria-hidden="true">
                04
              </span>
              <h3>API &amp; system integration</h3>
              <p>
                Connect the applications, databases, and services you already
                use. Integration helps data move between processes so your team
                can avoid repeated data entry.
              </p>
            </article>
          </div>
        </div>
      </section>
      <section
        class="section-wrap"
        id="pengalaman"
        aria-labelledby="work-heading"
      >
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">04 / DEVELOPMENT EXPERIENCE</p>
            <h2 id="work-heading">
              What we have
              <br />
              built.
            </h2>
            <p>
              Our experience covers the operational needs below. Share your
              business context so we can discuss a relevant approach.
            </p>
          </div>
          <div class="work-list">
            <article>
              <h3>
                <a
                  class="resource-link"
                  href="/studi-kasus/ai-quality-assurance/"
                >
                  AI for service quality evaluation ↗
                </a>
              </h3>
              <p>
                Recording pipelines, speech-to-text, evaluation grounded in
                knowledge and rubrics, coaching notes, and human review.
              </p>
            </article>
            <article>
              <h3>Salon POS &amp; reservations</h3>
              <p>
                Booking calendars, staff roles, checkout, and receipt printing
                for salon service workflows.
              </p>
            </article>
            <article>
              <h3>Service queue systems</h3>
              <p>
                Ticket issuance, queue calls, information displays, and service
                summaries and report exports.
              </p>
            </article>
            <article>
              <h3>Financial &amp; project monitoring</h3>
              <p>
                Budget, payment milestone, and expense monitoring, with receipt
                recording through mobile web.
              </p>
            </article>
            <article>
              <h3>Websites, CMS &amp; operational portals</h3>
              <p>
                Article and website content management, customer portals, and
                applications for transaction and inventory records.
              </p>
            </article>
          </div>
        </div>
      </section>
      <section
        class="section-wrap"
        id="pertanyaan"
        aria-labelledby="questions-heading"
      >
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">05 / GETTING STARTED</p>
            <h2 id="questions-heading">Before we discuss your project.</h2>
          </div>
          <dl class="question-list">
            <div>
              <dt>How much does a website or software project cost?</dt>
              <dd>
                Cost depends on features, integrations, and project complexity.
                Share your needs through WhatsApp so we can discuss an estimate
                based on a clear scope.
              </dd>
            </div>
            <div>
              <dt>What should I prepare for an initial discussion?</dt>
              <dd>
                Describe your business, the problem to solve, who will use the
                system, and any target timeline. Examples of current workflows
                or applications are also helpful.
              </dd>
            </div>
            <div>
              <dt>Can we discuss a project remotely?</dt>
              <dd>
                Yes. Initial discussions can start through WhatsApp from
                anywhere in Indonesia. We will discuss requirements, how to work
                together, and next steps around your project.
              </dd>
            </div>
          </dl>
        </div>
      </section>
      <section class="section-wrap" aria-labelledby="resources-heading">
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">EXPLORE FURTHER</p>
            <h2 id="resources-heading">Explore our approach.</h2>
            <p>
              Services, development experience, and guides to help you prepare
              for your project.
            </p>
          </div>
          <div class="resource-directory">
            {resourceGroups.map((group) => (
              <div class="resource-group">
                <h3 class="eyebrow">{group.kind}</h3>
                <ul>
                  {group.pages.map((page) => (
                    <li>
                      <a class="resource-link" href={`/${page.slug}/`}>
                        {page.title}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
      <section
        class="contact-section section-wrap"
        id="contact"
        aria-labelledby="contact-heading"
      >
        <div class="contact-card page-grid">
          <p class="eyebrow contact-label">DISCUSS A PROJECT</p>
          <h2 id="contact-heading">
            Planning something
            <br />
            for your business?
          </h2>
          <div class="contact-detail">
            <p>
              Tell us what you need.
              <br />
              Let’s discuss an approach and the next steps.
            </p>
            <a
              class="cds--btn cds--btn--primary contact-button contact-button-light"
              href={whatsapp}
              data-contact-location="contact"
              target="_blank"
              rel="noopener noreferrer"
            >
              Discuss your project{' '}
              <span class="button-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
            <a
              class="phone-link"
              href={whatsapp}
              data-contact-location="phone"
              target="_blank"
              rel="noopener noreferrer"
            >
              +62 817 131 366 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer page-grid">
      <a class="footer-brand" href="#top">
        EAST TOWN DIGITAL <span aria-hidden="true">↗</span>
      </a>
      <span>© {year} East Town Digital</span>
      <span class="footer-note">
        SOFTWARE HOUSE FOR BUSINESSES IN INDONESIA.
      </span>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
