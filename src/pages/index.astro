---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.scss';
import SeoHead from '../components/SeoHead.astro';
import { pages } from '../data/pages';

const whatsapp = 'https://wa.me/62817131366';
const year = new Date().getFullYear();
const canonical = new URL('/', Astro.site).href;
const title = 'Software House & Solusi AI Indonesia | East Town Digital';
const description =
  'Software house dan solusi AI untuk bisnis Indonesia. Berbekal 15+ tahun pengalaman IT, kami membangun AI agent, speech-to-text, dan aplikasi bisnis.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonical}#organization`,
      name: 'East Town Digital',
      url: canonical,
      description,
      logo: new URL('/logo.png', Astro.site).href,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+62817131366',
        contactType: 'sales',
        availableLanguage: ['Indonesian'],
        areaServed: { '@type': 'Country', name: 'Indonesia' },
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: 'East Town Digital',
      inLanguage: 'id-ID',
      publisher: { '@id': `${canonical}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'id-ID',
      isPartOf: { '@id': `${canonical}#website` },
      about: { '@id': `${canonical}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="id" class="cds--white">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      structuredData={structuredData}
    />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Langsung ke konten
    </a>
    <div class="announcement">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Babak baru. Berbekal 15+ tahun pengalaman di IT.</span>
      <span class="announcement-label">EAST TOWN DIGITAL</span>
    </div>
    <header class="site-header page-grid">
      <a class="brand" href="#top" aria-label="Beranda East Town Digital">
        <svg
          class="brand-mark"
          viewBox="0 0 40 40"
          fill="none"
          aria-hidden="true"
        >
          <path d="M4 6h29v6H10v5h19v6H10v5h23v6H4V6Z" fill="currentColor" />
          <path d="m27 16 9 4-9 4v-8Z" fill="currentColor" />
        </svg>
        <span>
          East Town<span class="brand-second">Digital</span>
        </span>
      </a>
      <nav class="header-note" aria-label="Navigasi utama">
        <a href="#ai">AI &amp; AUTOMASI</a>
        <a href="#layanan">LAYANAN</a>
        <a href="#pengalaman">PENGALAMAN</a>
        <a href="#contact">KONTAK</a>
      </nav>
      <a
        class="cds--btn cds--btn--tertiary header-contact"
        href={whatsapp}
        data-contact-location="header"
        target="_blank"
        rel="noopener noreferrer"
      >
        Hubungi Kami <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="field" aria-hidden="true">
          <canvas id="east-field"></canvas>
        </div>
        <div class="hero-inner page-grid">
          <p class="eyebrow hero-eyebrow" data-reveal>
            <span class="small-cross" aria-hidden="true">
              +
            </span>{' '}
            SOFTWARE &amp; AI UNTUK BISNIS INDONESIA
          </p>
          <h1 id="hero-heading">
            <span class="headline-start" data-reveal>
              Software house.
              <br />
              Untuk bisnis Anda.
            </span>
            <span class="headline-end" data-reveal>
              Dengan AI.
              <br />
              Lebih jauh.
            </span>
          </h1>
          <div class="hero-action" data-reveal>
            <p>
              Aplikasi, AI, dan automasi.
              <br />
              Berangkat dari kebutuhan Anda.
            </p>
            <a
              class="cds--btn cds--btn--primary contact-button"
              href={whatsapp}
              data-contact-location="hero"
              target="_blank"
              rel="noopener noreferrer"
            >
              Diskusi Proyek{' '}
              <span class="button-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
            <span class="contact-caption">LANGSUNG LEWAT WHATSAPP</span>
          </div>
          <div class="hero-baseline">
            <a class="scroll-link" href="#hello">
              <span aria-hidden="true">↓</span> KENALI KAMI
            </a>
            <span class="edition">PENGALAMAN PANJANG. SEMANGAT BARU.</span>
          </div>
        </div>
      </section>
      <section
        class="introduction section-wrap"
        id="hello"
        aria-labelledby="intro-heading"
      >
        <div class="intro-card page-grid">
          <p class="eyebrow intro-label" data-scroll-reveal>
            01 / TENTANG EAST TOWN DIGITAL
          </p>
          <div class="intro-copy" data-scroll-reveal>
            <h2 id="intro-heading">
              Nama baru.
              <br />
              Pengalaman yang matang.
            </h2>
            <p>
              East Town Digital adalah software house yang dibangun oleh dua
              partner dengan pengalaman lebih dari 15 tahun di dunia IT. Kami
              membantu bisnis di Indonesia mewujudkan kebutuhan digital melalui
              pengembangan website, aplikasi bisnis, aplikasi mobile, integrasi
              sistem, serta solusi AI. Tim kami aktif memanfaatkan AI dalam
              proses pengembangan dan membangun penerapannya untuk kebutuhan
              operasional bisnis.
            </p>
            <p>
              Setiap bisnis punya cara kerja sendiri. Karena itu, percakapan
              dimulai dari proses yang Anda jalankan, kendala yang dihadapi, dan
              tujuan yang ingin dicapai — agar software yang dibuat punya peran
              yang jelas.
            </p>
          </div>
          <div class="experience" data-scroll-reveal>
            <span class="experience-number">
              15<span>+</span>
            </span>
            <span class="eyebrow">TAHUN DI DUNIA IT</span>
            <span class="experience-line" aria-hidden="true"></span>
            <p>
              Pengalaman sebagai bekal.
              <br />
              Kebutuhan Anda sebagai arah.
            </p>
          </div>
          <div class="intro-bottom">
            <span>TEKNOLOGI YANG BERANGKAT DARI KEBUTUHAN.</span>
            <span aria-hidden="true">ETD ↗</span>
          </div>
        </div>
      </section>
      <section class="section-wrap" id="ai" aria-labelledby="ai-heading">
        <div class="editorial-card page-grid ai-card">
          <div class="section-heading" data-scroll-reveal>
            <p class="eyebrow">02 / AI DALAM PRAKTIK</p>
            <h2 id="ai-heading">
              AI yang bekerja.
              <br />
              Untuk kebutuhan nyata.
            </h2>
            <p>
              Kami menggunakan AI dalam cara kami membangun software, sekaligus
              membantu Anda menerapkannya pada pekerjaan bisnis. Dari agent
              hingga analisis percakapan, selalu dengan tujuan dan evaluasi yang
              jelas.
            </p>
            <a class="resource-link" href="/solusi-ai/">
              Jelajahi solusi AI <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="service-list">
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                01
              </span>
              <h3>AI agent &amp; agent harnesses</h3>
              <p>
                Beragam agent harnesses menjadi bagian dari workflow tim kami.
                Kami merancang konteks, penggunaan alat, dan integrasi agent
                dengan review engineer serta batas tindakan yang sesuai
                kebutuhan.
              </p>
            </article>
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                02
              </span>
              <h3>Training &amp; adaptasi AI</h3>
              <p>
                Penyiapan data, knowledge, dan evaluasi untuk menyesuaikan AI
                dengan konteks bisnis Anda. Metode adaptasi dan kebutuhan
                training dipilih berdasarkan kesiapan data, tujuan, dan hasil
                evaluasi.
              </p>
            </article>
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                03
              </span>
              <h3>Speech-to-text &amp; quality assurance</h3>
              <p>
                Ubah rekaman menjadi transkrip, evaluasi berbasis rubrik, dan
                bahan coaching. Pengalaman kami mencakup alur ini dengan koreksi
                reviewer serta ekspor laporan.
              </p>
              <a
                class="resource-link"
                href="/studi-kasus/ai-quality-assurance/"
              >
                Lihat pengalaman AI QA <span aria-hidden="true">↗</span>
              </a>
            </article>
          </div>
        </div>
      </section>
      <section
        class="section-wrap"
        id="layanan"
        aria-labelledby="services-heading"
      >
        <div class="editorial-card page-grid">
          <div class="section-heading" data-scroll-reveal>
            <p class="eyebrow">03 / LAYANAN KAMI</p>
            <h2 id="services-heading">
              Software yang mengikuti
              <br />
              cara kerja bisnis Anda.
            </h2>
            <p>
              Dari kehadiran digital hingga proses operasional, kami membantu
              Anda memilih dan membangun solusi yang sesuai kebutuhan.
            </p>
          </div>
          <div class="service-list">
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                01
              </span>
              <h3>Jasa pembuatan website</h3>
              <p>
                Website perusahaan, halaman produk, dan website dengan CMS agar
                tim Anda dapat mengelola konten sendiri. Dirancang untuk
                menyampaikan bisnis dengan jelas dan memudahkan calon pelanggan
                menghubungi Anda.
              </p>
            </article>
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                02
              </span>
              <h3>Aplikasi bisnis &amp; software custom</h3>
              <p>
                Pengembangan aplikasi untuk pencatatan transaksi, stok,
                reservasi, antrean, hingga monitoring keuangan dan proyek. Alur
                kerja disesuaikan dengan operasional bisnis Anda.
              </p>
            </article>
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                03
              </span>
              <h3>Pengembangan aplikasi mobile</h3>
              <p>
                Aplikasi untuk pelanggan atau tim lapangan, termasuk pengalaman
                web mobile dan PWA. Pilihan platform dan fitur dibahas
                berdasarkan perangkat, pengguna, dan kebutuhan pekerjaan.
              </p>
            </article>
            <article class="service-row" data-scroll-reveal>
              <span class="eyebrow" aria-hidden="true">
                04
              </span>
              <h3>Integrasi API &amp; sistem</h3>
              <p>
                Hubungkan aplikasi, database, dan layanan yang sudah digunakan.
                Integrasi membantu data mengalir antarproses sehingga tim tidak
                perlu mengulang pencatatan yang sama.
              </p>
            </article>
          </div>
        </div>
      </section>
      <section
        class="section-wrap"
        id="pengalaman"
        aria-labelledby="work-heading"
      >
        <div class="editorial-card page-grid">
          <div class="section-heading" data-scroll-reveal>
            <p class="eyebrow">04 / PENGALAMAN PENGEMBANGAN</p>
            <h2 id="work-heading">
              Dekat dengan
              <br />
              kebutuhan nyata.
            </h2>
            <p>
              Pengalaman kami mencakup berbagai kebutuhan operasional berikut.
              Ceritakan konteks bisnis Anda untuk membahas pendekatan yang
              relevan.
            </p>
          </div>
          <div class="work-list">
            <article data-scroll-reveal>
              <h3>
                <a
                  class="resource-link"
                  href="/studi-kasus/ai-quality-assurance/"
                >
                  AI untuk evaluasi kualitas layanan ↗
                </a>
              </h3>
              <p>
                Pipeline rekaman, speech-to-text, evaluasi dengan knowledge dan
                rubrik, catatan coaching, serta peninjauan oleh manusia.
              </p>
            </article>
            <article data-scroll-reveal>
              <h3>POS &amp; reservasi salon</h3>
              <p>
                Kalender pemesanan, pengaturan peran staf, kasir, dan pencetakan
                struk untuk alur layanan salon.
              </p>
            </article>
            <article data-scroll-reveal>
              <h3>Sistem antrean layanan</h3>
              <p>
                Pengambilan nomor, pemanggilan antrean, layar informasi, serta
                rekap dan ekspor laporan layanan.
              </p>
            </article>
            <article data-scroll-reveal>
              <h3>Monitoring keuangan &amp; proyek</h3>
              <p>
                Pemantauan anggaran, termin pembayaran, pengeluaran, dan
                pencatatan bukti transaksi melalui web mobile.
              </p>
            </article>
            <article data-scroll-reveal>
              <h3>Website, CMS &amp; portal operasional</h3>
              <p>
                Pengelolaan artikel dan konten website, portal pelanggan, serta
                aplikasi pencatatan transaksi dan stok.
              </p>
            </article>
          </div>
        </div>
      </section>
      <section
        class="section-wrap"
        id="pertanyaan"
        aria-labelledby="questions-heading"
      >
        <div class="editorial-card page-grid">
          <div class="section-heading" data-scroll-reveal>
            <p class="eyebrow">05 / SEBELUM MEMULAI</p>
            <h2 id="questions-heading">
              Mulai dari kebutuhan.
              <br />
              Bukan daftar fitur.
            </h2>
          </div>
          <dl class="question-list">
            <div data-scroll-reveal>
              <dt>Berapa biaya pembuatan website atau software?</dt>
              <dd>
                Biaya bergantung pada cakupan fitur, integrasi, dan kompleksitas
                proyek. Ceritakan kebutuhan Anda melalui WhatsApp agar estimasi
                dapat dibahas berdasarkan ruang lingkup yang jelas.
              </dd>
            </div>
            <div data-scroll-reveal>
              <dt>Apa yang perlu disiapkan untuk diskusi awal?</dt>
              <dd>
                Cukup jelaskan bisnis Anda, kendala yang ingin diselesaikan,
                siapa yang akan memakai sistem, serta target waktu jika ada.
                Contoh alur kerja atau aplikasi yang sudah digunakan juga
                membantu.
              </dd>
            </div>
            <div data-scroll-reveal>
              <dt>Apakah bisa berdiskusi dari luar kota?</dt>
              <dd>
                Bisa. Diskusi awal dapat dimulai melalui WhatsApp dari mana saja
                di Indonesia. Kebutuhan, cara kerja sama, dan langkah
                selanjutnya dibahas sesuai proyek Anda.
              </dd>
            </div>
          </dl>
        </div>
      </section>
      <section class="section-wrap" aria-labelledby="resources-heading">
        <div class="editorial-card page-grid">
          <div class="section-heading">
            <p class="eyebrow">JELAJAHI LEBIH LANJUT</p>
            <h2 id="resources-heading">Kenali pendekatan kami.</h2>
            <p>
              Layanan, pengalaman pengembangan, dan panduan untuk mempersiapkan
              proyek Anda.
            </p>
          </div>
          <div class="work-list">
            {pages.map((page) => (
              <article>
                <p class="eyebrow">{page.kind}</p>
                <h3>
                  <a class="resource-link" href={`/${page.slug}/`}>
                    {page.title} <span aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p>{page.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section
        class="contact-section section-wrap"
        id="contact"
        aria-labelledby="contact-heading"
      >
        <div class="contact-card page-grid">
          <p class="eyebrow contact-label" data-scroll-reveal>
            <span class="status-dot" aria-hidden="true"></span> MULAI DARI
            PERCAKAPAN
          </p>
          <h2 id="contact-heading" data-scroll-reveal>
            Ada rencana
            <br />
            untuk bisnis Anda?
          </h2>
          <div class="contact-detail" data-scroll-reveal>
            <p>
              Ceritakan kebutuhan Anda.
              <br />
              Mari bahas arah solusi dan langkah selanjutnya bersama.
            </p>
            <a
              class="cds--btn cds--btn--primary contact-button contact-button-light"
              href={whatsapp}
              data-contact-location="contact"
              target="_blank"
              rel="noopener noreferrer"
            >
              Diskusi Proyek{' '}
              <span class="button-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
            <a
              class="phone-link"
              href={whatsapp}
              data-contact-location="phone"
              target="_blank"
              rel="noopener noreferrer"
            >
              +62 817 131 366 <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="contact-watermark" aria-hidden="true">
            east town digital
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer page-grid">
      <a class="footer-brand" href="#top">
        EAST TOWN DIGITAL <span aria-hidden="true">↗</span>
      </a>
      <span>© {year} East Town Digital</span>
      <span class="footer-note">SOFTWARE HOUSE UNTUK BISNIS INDONESIA.</span>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
