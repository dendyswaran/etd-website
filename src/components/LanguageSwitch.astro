---
import { getLanguage, localizePath, createTranslator } from '../lib/i18n';
const lang = getLanguage(Astro.url.pathname);
const t = createTranslator(lang);
const path = Astro.url.pathname.replace(/\/?$/, '/');
const alternate = localizePath(path, lang === 'en' ? 'id' : 'en');
---

<nav class="language-switch" aria-label={t('Language')}>
  {lang === 'en' ? (
    <>
      <span lang="en" aria-current="true">
        EN
      </span>
      <span aria-hidden="true">/</span>
      <a
        href={alternate}
        lang="id"
        hreflang="id"
        data-language-switch
        aria-label="Baca halaman ini dalam bahasa Indonesia"
      >
        ID
      </a>
    </>
  ) : (
    <>
      <a
        href={alternate}
        lang="en"
        hreflang="en"
        data-language-switch
        aria-label="Baca halaman ini dalam bahasa Inggris"
      >
        EN
      </a>
      <span aria-hidden="true">/</span>
      <span lang="id" aria-current="true">
        ID
      </span>
    </>
  )}
</nav>
<script>
  document
    .querySelectorAll<HTMLAnchorElement>('[data-language-switch]')
    .forEach((link) =>
      link.addEventListener('click', () => {
        const url = new URL(link.href);
        url.hash = location.hash;
        link.href = url.href;
      }),
    );
</script>
