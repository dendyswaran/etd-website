---
import { getLanguage, createTranslator } from '../lib/i18n';
const lang = getLanguage(Astro.url.pathname);
const t = createTranslator(lang);
import TechnologyStack from './TechnologyStack.astro';
const groups = [
  {
    label: 'Application & audio services',
    items: [
      { name: 'Bun', icon: 'bun' },
      { name: 'Python', icon: 'python' },
    ],
  },
  {
    label: 'Reviewer interface',
    items: [
      { name: 'Vite', icon: 'vite' },
      { name: 'React', icon: 'react' },
      { name: 'TypeScript', icon: 'typescript' },
    ],
  },
  {
    label: 'Deployment & data',
    items: [
      { name: 'Docker', icon: 'docker' },
      { name: 'PostgreSQL', icon: 'postgresql' },
      { name: 'Redis', icon: 'redis' },
    ],
  },
];
---

<div class="integration-visual ai-visual">
  <figure
    class="integration-architecture ai-workflow"
    aria-labelledby="ai-workflow-heading ai-workflow-caption"
  >
    <div class="architecture-heading">
      <p class="eyebrow">
        {t('EXAMPLE AI WORKFLOW / AUDIO QUALITY ASSURANCE')}
      </p>
      <h2 id="ai-workflow-heading">
        {t('From a recorded conversation')}
        <br />
        {t('to a reviewable evaluation.')}
      </h2>
      <p>
        {t(
          'A defined processing pipeline, with evidence behind the assessment and people in control of the result.',
        )}
      </p>
    </div>
    <ol class="ai-pipeline">
      <li>
        <p class="eyebrow ai-step-number">{t('01 / INTAKE')}</p>
        <div class="ai-provider">
          <span>{t('Bun / Redis / PostgreSQL')}</span>
        </div>
        <h3>{t('Queue the recording')}</h3>
        <p>
          {t(
            'Upload audio, store the call record, and queue the job for processing.',
          )}
        </p>
        <p class="ai-stage-detail">
          {t('Job status, retry handling, and a traceable processing history.')}
        </p>
      </li>
      <li>
        <p class="eyebrow ai-step-number">{t('02 / TRANSCRIPTION')}</p>
        <div class="ai-provider">
          <img
            src="/technology/elevenlabs.svg"
            alt=""
            width="24"
            height="24"
            loading="lazy"
          />
          <span>{t('ElevenLabs')}</span>
        </div>
        <h3>{t('Turn speech into text')}</h3>
        <p>
          {t(
            'Create a transcript with speaker labels for downstream evaluation.',
          )}
        </p>
        <p class="ai-stage-detail">
          {t(
            'A Python audio service extracts features that add context to the assessment.',
          )}
        </p>
      </li>
      <li class="ai-stage-evaluation">
        <p class="eyebrow ai-step-number">{t('03 / EVALUATION')}</p>
        <div class="ai-provider">
          <img
            src="/technology/claude.svg"
            alt=""
            width="24"
            height="24"
            loading="lazy"
          />
          <span>{t('Sonnet 5.5')}</span>
        </div>
        <h3>{t('Evaluate against a rubric')}</h3>
        <p>
          {t(
            'Assess the transcript using product knowledge and scoring criteria.',
          )}
        </p>
        <p class="ai-stage-detail">
          {t(
            'Structured assessments, conversation evidence, and coaching notes.',
          )}
        </p>
      </li>
      <li>
        <p class="eyebrow ai-step-number">{t('04 / HUMAN REVIEW')}</p>
        <div class="ai-provider">
          <span>{t('Reviewer workspace')}</span>
        </div>
        <h3>{t('Review, correct, export')}</h3>
        <p>
          {t(
            'Reviewers inspect evidence, correct assessments, and export reports.',
          )}
        </p>
        <p class="ai-stage-detail">
          {t('The application recalculates scores using the rubric weights.')}
        </p>
      </li>
    </ol>
    <div class="ai-workflow-context">
      <p class="eyebrow">{t('EVALUATION CONTEXT')}</p>
      <p>
        {t('Product knowledge')} <span aria-hidden="true">+</span>{' '}
        {t('Assessment rubric')} <span aria-hidden="true">+</span>{' '}
        {t('Reviewer examples')}
      </p>
      <p>
        {t(
          'Reviewer examples supply context for later evaluations. They do not imply that the model has been retrained.',
        )}
      </p>
    </div>
    <aside class="ai-development" aria-label={t('Development workflow')}>
      <div>
        <p class="eyebrow">{t('DEVELOPMENT WORKFLOW')}</p>
        <h3>{t('Codex + engineer review')}</h3>
      </div>
      <p>
        {t(
          'Codex supports implementation. Engineers review the code and run tests before delivery.',
        )}
      </p>
    </aside>
    <figcaption id="ai-workflow-caption">
      {t(
        'Illustrative audio QA workflow based on our development experience. Processing rules, data access, and evaluation criteria are scoped to each project.',
      )}
    </figcaption>
  </figure>
  <TechnologyStack
    headingId="ai-technologies-heading"
    title={t('The stack behind the workflow.')}
    description={t(
      'Bun for application services, Python for audio analysis, and a Vite, React, and TypeScript reviewer interface. Docker, PostgreSQL, and Redis support deployment, records, and background processing.',
    )}
    groups={groups}
  />
</div>
