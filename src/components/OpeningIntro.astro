<div
  id="opening-intro"
  class="opening-intro"
  hidden
  aria-label="East Town Digital introduction"
>
  <div class="intro-surface" aria-hidden="true">
    <svg class="intro-pattern" width="100%" height="100%">
      <defs>
        <pattern
          id="intro-lines"
          width="24"
          height="24"
          patternUnits="userSpaceOnUse"
        >
          <path d="M12 8v8" fill="none" stroke="currentColor" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#intro-lines)" />
    </svg>
    <div class="intro-meta page-grid">
      <span>INDEPENDENT SOFTWARE HOUSE</span>
      <span>INDONESIA</span>
    </div>
    <div class="intro-bars">
      {Array.from({ length: 16 }, () => (
        <span class="intro-bar" />
      ))}
    </div>
    <p class="intro-caption">SOFTWARE / SYSTEMS / AI</p>
  </div>
  <div class="intro-identity brand" aria-hidden="true">
    <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
      <path
        class="intro-mark-shape"
        d="M4 6h29v6H10v5h19v6H10v5h23v6H4V6Z"
        fill="currentColor"
      />
      <path
        class="intro-mark-arrow"
        d="m27 16 9 4-9 4v-8Z"
        fill="currentColor"
      />
    </svg>
    <span class="intro-name">
      <span class="intro-word-mask">
        <span class="intro-word">East Town</span>
      </span>
      <span class="intro-word-mask">
        <span class="intro-word">Digital</span>
      </span>
    </span>
  </div>
  <button class="cds--btn cds--btn--ghost intro-skip" type="button">
    Skip intro <span aria-hidden="true">↗</span>
  </button>
</div>
<script is:inline data-intro-bootstrap>
  (() => {
    const root = document.documentElement;
    const screen = document.getElementById('opening-intro');
    if (
      !screen ||
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      location.hash
    )
      return;
    try {
      if (
        sessionStorage.getItem('etd:intro-seen') &&
        !new URLSearchParams(location.search).has('intro')
      )
        return;
    } catch {
      /* The introduction also works when browser storage is unavailable. */
    }
    screen.hidden = false;
    root.dataset.intro = 'pending';
    const deadline = setTimeout(() => {
      delete root.dataset.intro;
      screen.hidden = true;
      document
        .querySelectorAll('.site-header, main, .site-footer')
        .forEach((el) => {
          el.inert = false;
        });
      document.querySelectorAll('[data-intro-animated]').forEach((el) => {
        ['transform', 'opacity', 'visibility'].forEach((property) =>
          el.style.removeProperty(property),
        );
      });
      document.dispatchEvent(new Event('etd:intro-timeout'));
    }, 4500);
    document.addEventListener(
      'etd:intro-complete',
      () => clearTimeout(deadline),
      { once: true },
    );
    // BFCache snapshots must never preserve a screen that covers the document.
    window.addEventListener(
      'pagehide',
      () => {
        delete root.dataset.intro;
        screen.hidden = true;
        document
          .querySelectorAll('.site-header, main, .site-footer')
          .forEach((el) => {
            el.inert = false;
          });
      },
      { once: true },
    );
  })();
</script>
